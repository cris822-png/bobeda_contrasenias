# ─────────────────────────────────────────────────────────────
# Backend .env.example  —  copy to .env and fill in real values
# .env is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# --- API Server -----------------------------------------------
# Render provides the PORT variable dynamically.
# API_PORT is used as a fallback for local development.
PORT=
API_PORT=8443

# --- PostgreSQL (Neon / Production or Local) ------------------
# For Neon or Production environments, provide the full URL.
# If DATABASE_URL is set, the individual DB_* variables below are ignored.
DATABASE_URL=

# (Fallback) Local Development Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vault_db
DB_USER=bob
DB_PASSWORD=CHANGE_ME_strong_password # pragma: allowlist secret
# SSL mode: disable | allow | prefer | require | verify-ca | verify-full
DB_SSL_MODE=prefer

# --- Redis (Upstash / Production or Local) --------------------
# For Upstash or Production environments, provide the full URL.
# If REDIS_URL is set, the REDIS_HOST/PORT/PASSWORD are ignored.
# Ensure you use rediss:// for TLS encrypted connections.
REDIS_URL=

# (Fallback) Local Development Variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRY_MINUTES=15

# --- Rate Limiting --------------------------------------------
RATELIMIT_AUTH_MAX_REQUESTS=5
RATELIMIT_AUTH_WINDOW_SECONDS=180
RATELIMIT_API_MAX_REQUESTS=100
RATELIMIT_API_WINDOW_SECONDS=60
